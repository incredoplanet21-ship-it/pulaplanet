#!/usr/bin/env bash
# Format staged source files before the commit is created.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

pattern='\.(ts|tsx|js|jsx|mjs|cjs|mts|css|json|md|html|yml|yaml)$'
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$pattern" || true)

if [ -z "$staged" ]; then
  exit 0
fi

files=()
while IFS= read -r file; do
  [ -n "$file" ] && files+=("$file")
done <<EOF
$staged
EOF

npx prettier --write -- "${files[@]}"
git add -- "${files[@]}"
